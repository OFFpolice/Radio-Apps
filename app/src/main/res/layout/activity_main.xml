<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <!-- App Header containing App title and Search bar -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/app_card_bg"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title "WebRadioBot" aligned to center -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/primary_pink"
                android:textSize="24sp"
                android:textStyle="bold"
                android:text="WebRadioBot" />
        </FrameLayout>

        <!-- Search row wrapper -->
        <LinearLayout
            android:id="@+id/search_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/app_text_secondary" />

            <EditText
                android:id="@+id/edt_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:hint="Поиск станций..."
                android:textColorHint="@color/app_text_secondary"
                android:textColor="@color/app_text_primary"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_close"
                android:tint="@color/app_text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT switcher containing three distinct lists/options folders -->
    <FrameLayout
        android:id="@+id/tab_content_parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@id/divider_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ============== TAB 1: RADIO ============== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tab_radio_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- Section Head Label -->
            <LinearLayout
                android:id="@+id/section_head_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_radio"
                    android:tint="@color/secondary_pink" />

                <TextView
                    android:id="@+id/txt_section_title_radio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:text="ВСЕ РАДИОСТАНЦИИ" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stations"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/section_head_radio"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Progress Load Spinner on bottom pagination layout -->
            <ProgressBar
                android:id="@+id/bottom_loading_indicator"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="12dp"
                android:indeterminateTint="@color/primary_pink"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Empty result layout -->
            <LinearLayout
                android:id="@+id/radio_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_search_off"
                    android:tint="@color/app_text_muted" />

                <TextView
                    android:id="@+id/radio_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="15sp"
                    android:text="Ничего не найдено" />
            </LinearLayout>

            <!-- Scroll inside FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_scroll_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_arrow_up"
                app:backgroundTint="@color/secondary_pink"
                app:tint="@android:color/white"
                app:fabSize="mini"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="Scroll up button" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============== TAB 2: FAVORITES ============== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tab_favorites_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Section Head Label -->
            <LinearLayout
                android:id="@+id/section_head_fav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_favorite"
                    android:tint="@color/secondary_pink" />

                <TextView
                    android:id="@+id/txt_section_title_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:text="ОБРАННЕ" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_favorites"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/section_head_fav"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Empty favorites layout -->
            <LinearLayout
                android:id="@+id/favorites_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="@color/app_text_muted" />

                <TextView
                    android:id="@+id/favorites_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="15sp"
                    android:text="Нет избранных станций" />
            </LinearLayout>

            <!-- Scroll inside FAB favorites -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_fav_scroll_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_arrow_up"
                app:backgroundTint="@color/secondary_pink"
                app:tint="@android:color/white"
                app:fabSize="mini"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="Scroll up button" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============== TAB 3: SETTINGS ============== -->
        <ScrollView
            android:id="@+id/tab_settings_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <!-- Section Head Label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/secondary_pink" />

                    <TextView
                        android:id="@+id/txt_section_title_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:text="НАСТРОЙКИ" />
                </LinearLayout>

                <!-- Language Card Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/title_setting_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_pink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Язык" />

                    <RadioGroup
                        android:id="@+id/group_language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/radio_lang_auto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Определить автоматически"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:buttonTint="@color/primary_pink"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/radio_lang_en"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="English"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:buttonTint="@color/primary_pink"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/radio_lang_ru"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Русский"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:buttonTint="@color/primary_pink"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/radio_lang_uk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Украинский"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:buttonTint="@color/primary_pink"
                            android:paddingVertical="8dp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Theme Card Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/title_setting_theme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_pink"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Тема" />

                    <RadioGroup
                        android:id="@+id/group_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/radio_theme_system"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Система"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:buttonTint="@color/primary_pink"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/radio_theme_light"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Светлая"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:buttonTint="@color/primary_pink"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/radio_theme_dark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Тёмная"
                            android:textColor="@color/app_text_primary"
                            android:textSize="14sp"
                            android:buttonTint="@color/primary_pink"
                            android:paddingVertical="8dp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- About Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_card"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_radio"
                        android:tint="@color/secondary_pink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/app_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:text="WebRadioBot" />

                    <TextView
                        android:id="@+id/about_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Слушайте тысячи радиостанции со всего мира. Добавляйте любимые в избранное для быстрого доступа." />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#1F888888" />

                    <TextView
                        android:id="@+id/socials_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_pink"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:text="ПОЛЕЗНЫЕ ССЫЛКИ" />

                    <!-- Telegram Row Button -->
                    <LinearLayout
                        android:id="@+id/btn_link_tg1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tag_active"
                            android:padding="8dp"
                            android:src="@drawable/ic_telegram"
                            android:tint="@color/primary_pink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="Telegram" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="12sp"
                                android:text="\@OFFpolice" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_launch"
                            android:tint="@color/app_text_muted" />
                    </LinearLayout>

                    <!-- X (Twitter) Row Button -->
                    <LinearLayout
                        android:id="@+id/btn_link_x"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tag_active"
                            android:padding="8dp"
                            android:src="@drawable/ic_x"
                            android:tint="@color/primary_pink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="X (Twitter)" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="12sp"
                                android:text="\@OFFpolice2077" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_launch"
                            android:tint="@color/app_text_muted" />
                    </LinearLayout>

                    <!-- Instagram Row Button -->
                    <LinearLayout
                        android:id="@+id/btn_link_instagram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tag_active"
                            android:padding="8dp"
                            android:src="@drawable/ic_instagram"
                            android:tint="@color/primary_pink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="Instagram" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="12sp"
                                android:text="\@offpolice2077" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_launch"
                            android:tint="@color/app_text_muted" />
                    </LinearLayout>

                    <!-- Telegram Mini-App Row Button -->
                    <LinearLayout
                        android:id="@+id/btn_link_tg2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_tag_active"
                            android:padding="8dp"
                            android:src="@drawable/ic_telegram"
                            android:tint="@color/primary_pink" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="WebRadioBot" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="12sp"
                                android:text="t.me/Web_radio_bot/app" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_launch"
                            android:tint="@color/app_text_muted" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#1F888888" />

                    <!-- Developer API Link Text -->
                    <TextView
                        android:id="@+id/link_dev_api"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:textColor="@color/primary_pink"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="API Для разработчиков!" />

                    <TextView
                        android:id="@+id/version_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/app_text_muted"
                        android:textSize="11sp"
                        android:textStyle="normal"
                        android:text="Версия 1.0.0 • Android App" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bordering Line between Content area and Player Controller -->
    <View
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F888888"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar_layout" />

    <!-- BOTTOM Block enclosing Player Bar and Navigation Tabs -->
    <LinearLayout
        android:id="@+id/bottom_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/app_card_bg"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Player controls sub-bar -->
        <LinearLayout
            android:id="@+id/player_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <!-- Circular Play Control FAB Button -->
            <ImageButton
                android:id="@+id/play_toggle_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_play_btn"
                android:tint="@android:color/white"
                android:contentDescription="Play Toggle Toggle"
                android:scaleType="centerInside" />

            <!-- Track display ticker (Selected Station Label) -->
            <TextView
                android:id="@+id/playing_station_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:textColor="@color/app_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="Выберите станцию" />

            <!-- Connection dot and state ticker layout -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Colored Status indicator -->
                <ImageView
                    android:id="@+id/player_status_indicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/app_text_secondary" />

                <TextView
                    android:id="@+id/player_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="Ожидание" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider separating Player block and Nav keys -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#14888888" />

        <!-- High-performance Custom Tab Nav panel -->
        <LinearLayout
            android:id="@+id/app_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- NAV KEY 1: RADIO -->
            <LinearLayout
                android:id="@+id/nav_item_radio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/nav_icon_radio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_radio"
                    android:tint="@color/primary_pink" />

                <TextView
                    android:id="@+id/nav_label_radio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/primary_pink"
                    android:textSize="11sp"
                    android:text="Радио" />
            </LinearLayout>

            <!-- NAV KEY 2: FAVORITES -->
            <LinearLayout
                android:id="@+id/nav_item_favorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/nav_icon_favorites"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="@color/app_text_secondary" />

                <TextView
                    android:id="@+id/nav_label_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11sp"
                    android:text="Избранное" />
            </LinearLayout>

            <!-- NAV KEY 3: SETTINGS -->
            <LinearLayout
                android:id="@+id/nav_item_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/nav_icon_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/app_text_secondary" />

                <TextView
                    android:id="@+id/nav_label_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11sp"
                    android:text="Настройки" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FULLSCREEN INITIALIZING CONNECTION PAGE OVERLAY -->
    <include
        android:id="@+id/loading_screen_overlay"
        layout="@layout/full_screen_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
