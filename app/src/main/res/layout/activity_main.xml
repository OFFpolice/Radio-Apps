<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- 1. FULLSCREEN LOADING SCREEN (SPLASH) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loadingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E0E0E"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Logo Ring Header Container -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp">

                <!-- Inner Pulsing Radio Logo Bg -->
                <View
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/active_tag_bg_rounded" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_radio"
                    android:contentDescription="Radio Logo Icon"
                    app:tint="@color/white" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WebRadioBot"
                android:textSize="28sp"
                android:textColor="@color/primary_pink"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тысячи станций со всего мира"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <!-- Animated Equalizer View -->
            <com.example.ui.EqualizerView
                android:id="@+id/loadingEqualizer"
                android:layout_width="160dp"
                android:layout_height="28dp"
                android:layout_marginTop="40dp" />

            <!-- Horizontal Progress bar custom -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="4dp"
                android:background="#2A2A2A"
                android:layout_marginTop="32dp">

                <View
                    android:id="@+id/loadingProgressMeter"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:background="@color/primary_pink" />

            </FrameLayout>

            <TextView
                android:id="@+id/loadingStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Инициализация..."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. MAIN APP CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainAppContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Header containing Search and Title -->
        <LinearLayout
            android:id="@+id/appHeaderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="WebRadioBot"
                android:textSize="24sp"
                android:textColor="@color/primary_pink"
                android:textStyle="bold" />

            <!-- Search Area Wrap with Rounded Shape -->
            <LinearLayout
                android:id="@+id/searchRowContainer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/search_bg_rounded"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Поиск станций..."
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageView
                    android:id="@+id/clearSearchBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Clear search"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Switchable Tab Container Frame -->
        <FrameLayout
            android:id="@+id/tabContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/appHeaderLayout"
            app:layout_constraintBottom_toTopOf="@id/playerBar">

            <!-- RADIO TAB PAGES -->
            <FrameLayout
                android:id="@+id/radioTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/radioRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Radio stations list"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:scrollbars="vertical" />

                <!-- Empty Radio Results state -->
                <LinearLayout
                    android:id="@+id/emptyRadioLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_search_off"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ничего не найдено"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/radioPaginationLoader"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:indeterminateTint="@color/primary_pink"
                    android:visibility="gone" />

                <!-- Scroll to top FAB -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/radioScrollToTopBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="20dp"
                    android:src="@drawable/ic_arrow_upward"
                    app:backgroundTint="@color/secondary_pink"
                    app:tint="@color/white"
                    app:fabSize="mini"
                    android:visibility="gone"
                    android:contentDescription="Scroll to top" />

            </FrameLayout>

            <!-- FAVORITES TAB PAGES -->
            <FrameLayout
                android:id="@+id/favoritesTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/favoritesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Favorite stations list"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:scrollbars="vertical" />

                <!-- Empty Favorites state -->
                <LinearLayout
                    android:id="@+id/emptyFavoritesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_favorite_border"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Нет избранных станций"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

                <!-- Scroll to top FAB for Favorites -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/favoritesScrollToTopBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="20dp"
                    android:src="@drawable/ic_arrow_upward"
                    app:backgroundTint="@color/secondary_pink"
                    app:tint="@color/white"
                    app:fabSize="mini"
                    android:visibility="gone"
                    android:contentDescription="Scroll to top favorites" />

            </FrameLayout>

            <!-- ABOUT TAB PAGE -->
            <ScrollView
                android:id="@+id/aboutTab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_radio"
                        app:tint="@color/secondary_pink"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WebRadioBot"
                        android:textSize="24sp"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Слушайте тысячи радиостанции со всего мира. Добавляйте любимые в избранное для быстрого доступа."
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version: 1.0.0 · Android App"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="32dp"
                        android:textStyle="bold" />

                </LinearLayout>

            </ScrollView>

        </FrameLayout>

        <!-- PERSISTENT PLAYER BAR -->
        <RelativeLayout
            android:id="@+id/playerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/card_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

            <!-- Horizontal divider line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#14FFFFFF"
                android:layout_alignParentTop="true" />

            <!-- Circle play button -->
            <ImageButton
                android:id="@+id/playToggleBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/active_tag_bg_rounded"
                android:src="@drawable/ic_play"
                android:contentDescription="Play/Pause toggle"
                app:tint="@color/white" />

            <!-- Status Indicator layout at right -->
            <LinearLayout
                android:id="@+id/playerStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/playerStatusIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_circle"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/playerStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ожидание"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Marquee Running track title -->
            <TextView
                android:id="@+id/playingStationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/playToggleBtn"
                android:layout_toStartOf="@id/playerStatusContainer"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="Выберите станцию"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- MATERIAL BOTTOM NAVIGATION -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A1A1A"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/primary_pink"
            app:itemTextColor="@color/text_secondary"
            app:itemRippleColor="#1AE91E63"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
