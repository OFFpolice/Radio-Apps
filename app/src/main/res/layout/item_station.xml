<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/station_card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_station_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Station Cover Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/favicon_card"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/search_bg">

        <ImageView
            android:id="@+id/favicon_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_radio"
            android:contentDescription="Station Favicon Cover"
            app:tint="@color/secondary_pink" />
    </androidx.cardview.widget.CardView>

    <Spacer
        android:layout_width="12dp"
        android:layout_height="match_parent" />

    <!-- Details Box -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/station_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Station Name"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spacer
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <!-- Tags Flex/Row -->
        <LinearLayout
            android:id="@+id/tags_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Programmatically inflates dynamic tag views here -->
        </LinearLayout>
    </LinearLayout>

    <Spacer
        android:layout_width="8dp"
        android:layout_height="match_parent" />

    <!-- Favorite Icon Toggle Button (>= 48dp Touch Target) -->
    <FrameLayout
        android:id="@+id/fav_btn_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:focusable="true">

        <ImageView
            android:id="@+id/fav_toggle_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_favorite_border"
            android:contentDescription="Favorite Toggle icon"
            app:tint="@color/text_secondary" />
    </FrameLayout>
</LinearLayout>
