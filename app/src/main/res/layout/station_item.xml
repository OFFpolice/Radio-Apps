<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stationCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/card_bg_rounded"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Cover Art Container with Rounded Corners -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/coverCardView"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#2C2C2C"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/stationCoverImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_radio"
            android:contentDescription="Station Logo Cover Image"
            app:tint="@color/secondary_pink" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Info Column Container -->
    <LinearLayout
        android:id="@+id/infoLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/coverCardView"
        app:layout_constraintEnd_toStartOf="@id/favoriteBtn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Title and Playing Equalizer Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Радио НАЗВАНИЕ" />

            <!-- Compact List Play indicator shown only on playing items -->
            <com.example.ui.CompactEqualizerView
                android:id="@+id/compactEqualizer"
                android:layout_width="16dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Dynamic tag chip badges row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <!-- Tag Chip 1 -->
            <TextView
                android:id="@+id/tagChip1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tag_bg_rounded"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="radio"
                android:layout_marginEnd="4dp" />

            <!-- Tag Chip 2 -->
            <TextView
                android:id="@+id/tagChip2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tag_bg_rounded"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="pop"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

            <!-- Tag Chip 3 -->
            <TextView
                android:id="@+id/tagChip3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tag_bg_rounded"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="music"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Favorite Toggle Button -->
    <ImageButton
        android:id="@+id/favoriteBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_favorite_border"
        android:contentDescription="Favorite Toggle Button"
        app:tint="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
